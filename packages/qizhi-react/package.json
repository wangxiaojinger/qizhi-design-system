{
  "name": "@wangxiaojinger/qizhi-react",
  "version": "0.7.1",
  "description": "QIZHI neutral enterprise-admin Ant Design components.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/qizhi-react.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxiaojinger/qizhi-design-system.git",
    "directory": "packages/qizhi-react"
  },
  "homepage": "https://github.com/wangxiaojinger/qizhi-design-system#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@wangxiaojinger/qizhi-tokens": "workspace:*"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "antd": "^6.6.6",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
